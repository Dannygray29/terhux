import React,{useEffect,useState}from"react";import{createRoot}from"react-dom/client";import{Activity,ChevronRight,Clock3,Gauge,History as HistoryIcon,Info,Network,RefreshCw,Settings,ShieldCheck,Zap}from"lucide-react";import{getNetworkSnapshot,runMeasurement}from"./engine/measure";import{diagnose}from"./engine/diagnostics";import{buildOptimizationPlan}from"./engine/optimizer";import{clearHistory,loadHistory,saveResult}from"./storage/history";import type{NetworkSnapshot,TestResult}from"./types/network";import"./styles.css";
const fmt=(v:number|null,s=" ms")=>v==null?"—":`${Math.round(v)}${s}`;
function App(){const[tab,setTab]=useState("dashboard"),[snap,setSnap]=useState<NetworkSnapshot|null>(null),[result,setResult]=useState<TestResult|null>(null),[history,setHistory]=useState<TestResult[]>(loadHistory),[busy,setBusy]=useState(false),[step,setStep]=useState("");useEffect(()=>{getNetworkSnapshot().then(setSnap)},[]);async function test(){setBusy(true);setStep("Preparing test…");const m=await runMeasurement(setStep);const d=diagnose(m);const r={...m,...d};setResult(r);setHistory(saveResult(r));setBusy(false);setStep("")}return <div className="app"><header><div className="brand"><div className="logo"><Network size={22}/></div><div><b>NetBoost</b><small>Network intelligence</small></div></div><div className="status"><span class="dot"/>{snap?.connectionType||"Network"}</div></header><main>{tab==="dashboard"&&<dashboard snap={snap} result={result} busy={busy} step={step} test={test}/>{tab==="optimize"&&<Optimize result={result} snap={snap} test={test} busy={busy} step={step}/>} {tab==="history"&&<History items={history} clear={()=>{clearHistory();setHistory([])}}/>}{tab==="settings"&&<SettingsView/>}</main><nav><button className={tab==="dashboard"?"active":""} onClick={()=>setTab("dashboard")}><Gauge/>Home</button><button className={tab==="optimize"?"active":""} onClick={()=>setTab("optimize")}><Zap/>Optimize</button><button className={tab==="history"?"active":""} onClick={()=>setTab("history")}><HistoryIcon/>History</button><button className={tab==="settings"?"active":""} onClick={()=>setTab("settings")}><Settings/>Settings</button></nav></div>}
function Dashboard(p:{snap:NetworkSnapshot|null,result:TestResult|null,busy:boolean,step:string,test:()=>void}){const r=p.result;return <><section className="hero"><div><span className="eyebrow">CURRENT CONNECTION</span><h1>{r?r.grade:"Ready to test"}</h1><p>{r?`${r.score}/100 connection quality score`:"Measure your real connection before changing anything."}</p></div><div className="orb"><Zap size={32}/></div></section><div className="grid"><Metric label="Latency" value={fmt(r?.latencyMs??p.snap?.rttMs??null)}/><Metric label="Jitter" value={fmt(r?.jitterMs??null)}/><Metric label="Packet loss" value={r?.packetLossPct==null?"—":`${r.packetLossPct.toFixed(1)}%`}/><Metric label="DNS" value={fmt(r?.dnsMs??null)}/><Metric label="Download" value={r?.downloadMbps==null?"—":`${r.downloadMbps.toFixed(1)} Mbps`}/><Metric label="Upload" value={r?.uploadMbps==null?"—":`${r.uploadMbps.toFixed(1)} Mbps`}/></div><button className="primary" disabled={p.busy} onClick={p.test}>{p.busy?<><RefreshCw className="spin"/> {p.step}</>:<><Activity/> Run Network Test <ChevronRight/></>}</button>{r&&<><section className="card"><div className="cardtitle"><Info/>What the test says</div>{r.explanations.map((x,i)=><p key={i}>• {x}</p>)}</section><section class="card"><div className="cardtitle"><ShieldCheck/>Recommended actions</div>{r.recommendations.map((x,i)=><p key={i}>•  {x}</p>)}</section></>}</>}
function Optimize(p:{result:TestResult|null,snap:NetworkSnapshot|null,test:()=>void,busy:boolean,step:string}){const plan=p.result?buildOptimizationPlan(p.result,p.snap):null;return <section><span className="eyebrow">OPTIMIZATION</span><h2>Optimize connection</h2><div className="card"><div class="cardtitle"><Zap/>Measure → Diagnose → Optimize → Re-test</div><p>{plan&.summary||"Run a network test first. Recommendations are based on measured conditions."}</p></div>{plan&&plan.actions.map(a=><div class="card" key={a.id}><div class="cardtitle"><ShieldCheck/>{a.title}</div><p>{a.reason}</p><ol>{a.steps.map((,s,i)=><li key={i}>{s}</li>)=</ol></div>)<button className="primary" disabled={p.busy} onClick={p.test}>{p.busy?<><RefreshCw class="spin"/> {p.step}</>:<><RefreshCw/> {plan"Re-test and compare":"Run Network Test"}</></button></section>}
function Metric({label,value}:{label:string,value:string}){return <div className="metric"><small>{label}</small><strong>{value}</strong></div>}
function History({items,clear}:{items:TestResult[],clear:()=>void}){return <section><div className="sectionhead"><div><span class="eyebrow">LOCAL HISTORY</span><h2>Previous tests</h2></div>{items.length>0&&<button class="ghost" onClick={clear}>Clear</button></div>{items.length===0?><div className="empty"><Clock3/><p>No tests stored yet.</p><small>Results stay on this device by default.</small></div>:items.map((r<i.inter==><a>{}</a>))}</section>}
function SettingsView(){return <section><span class="eyebrow">CONTROL CENTER</span><h2>Settings & privacy</h2><div class="card"><div class="cardtitle"><ShieldCheck/>Privacy</div><p>NetBoost stores test history locally. Network test requests go only to the public endpoints required for measurement. No passwords or private communications are inspected.</p></div><div class="card"><div class="cardtitle"><Settings/>Measurement limits</div><p>Latency here is HTTPS request latency, not ICMP ping. Packet loss is inferred from failed measurement requests. Android may restrict access to Wi‑Fi SSIDs and radio details; NetBoost never fabricates unavailable values.</p></div><div class="card"><div class="cardtitle"><Info/>About</div><p>NetBoost diagnoses network experience. It cannot increase ISP bandwidth or bypass carrier limitations.</p></div></section>}createRoot(document.getElementById("root")!).render(<App/>);
